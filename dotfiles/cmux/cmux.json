{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "computerUse": {
    "enabled": false,
    "showInMenuBar": false
  },
  "schemaVersion": 1,
  "actions": {
    "group.remove": {
      "type": "command",
      "title": "Remove Workspace from Group",
      "subtitle": "Move the current workspace out of its group to the top level",
      "keywords": ["ungroup", "group"],
      "command": "cmux workspace-group remove --workspace \"$CMUX_WORKSPACE_ID\"; exit",
      "target": "newTabInCurrentPane",
      "shortcut": "cmd+shift+j"
    }
  },
  "shortcuts": {
    "bindings": {
      "nextSidebarTab": "cmd+shift+]",
      "nextSurface": "cmd+ctrl+]",
      "prevSidebarTab": "cmd+shift+[",
      "prevSurface": "cmd+ctrl+[",
      "focusLeft": "cmd+opt+[",
      "focusRight": "cmd+opt+]"
    }
  },
  "sidebar": {
    "fontSize": 14,
    "showAgentActivity": true
  },
  "sidebarAppearance": {
    "tintColor": "#3E5B9A",
    "tintOpacity": 0.28
  },
  "surfaceTabBar": {
    "fontSize": 14
  },
  "workspaceColors": {
    "selectionColor": "#2C2C2E"
  }
}
