{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["plugins/*/extensions/**/*.ts", "plugins/*/api.ts", "plugins/shared/**/*.ts"],
	"exclude": ["**/tests/**"]
}
