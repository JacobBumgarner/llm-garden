{
  "name": "llm-garden",
  "version": "0.9.0",
  "description": "Jacob Bumgarner's agent skills and pi extensions: orchestrate and code-review skills, plus ask, subagent, rename, editor-border, stash, focus-mode, footer, breath, final-marker, and clean-copy extensions.",
  "author": "Jacob Bumgarner",
  "repository": {
    "type": "git",
    "url": "https://github.com/JacobBumgarner/llm-garden"
  },
  "keywords": [
    "pi-package",
    "agent-skills"
  ],
  "pi": {
    "extensions": [
      "./plugins/*/extensions/index.ts"
    ],
    "skills": [
      "./plugins/*/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --import ./plugins/ask/tests/register.ts --test 'plugins/*/tests/*.test.ts'",
    "test:live": "node --import ./plugins/ask/tests/register.ts --test 'plugins/*/tests/*.live.ts'",
    "test:py": "python3 -m unittest discover -s plugins/rubato/tests -p 'test_*.py'",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.5",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
